<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.springbootdemo.dao.UserDao">

    <!-- 分页查询 -->
    <select id="findUserPage" resultType="com.example.springbootdemo.model.User">
        SELECT * FROM user
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!-- 保存用户 -->
    <insert id="save" parameterType="com.example.springbootdemo.model.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (`name`, `password`, remark)
        VALUES (#{name}, #{password}, #{remark})
    </insert>

</mapper>